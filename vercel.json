{
  "buildCommand": "npm run build",
  "outputDirectory": "test-ui",
  "framework": null,
  "functions": {
    "api/redact.mjs": {
      "runtime": "nodejs22.x",
      "includeFiles": "dist/custom-pattern-worker.js"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
